# Copy this file to .env.local and fill in the two values from
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# The address of your website (used in invite links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shows the "Demo" tab with practice logins (after running supabase/demo-seed.sql). Keep false on the real website.
NEXT_PUBLIC_DEMO_LOGIN=false

# ---- WhatsApp (server only, never put NEXT_PUBLIC_ in front) ----
# From Meta → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# From Supabase → Authentication → Auth Hooks → Send SMS hook (starts with v1,whsec_)
SEND_SMS_HOOK_SECRET=
# Template names you created in Meta (defaults shown)
WHATSAPP_TEMPLATE_LOGIN=login_code
WHATSAPP_TEMPLATE_LEAD_ASSIGNED=lead_assigned
WHATSAPP_TEMPLATE_LANG=en
# Verify clients on WhatsApp (website brochure). Company WhatsApp number with country code, the app secret, and a word you choose for the webhook
WHATSAPP_VERIFY_NUMBER=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ---- Automatic lead capture ----
# Supabase → Project Settings → API Keys → service_role / secret key. Server only. Needed for Facebook lead ads.
SUPABASE_SERVICE_ROLE_KEY=
# Facebook / Instagram lead ads (Meta app → Settings → Basic → App secret)
META_APP_SECRET=
# Any long random word you choose; type the same word in the Meta webhook settings
META_VERIFY_TOKEN=

# ---- Morning WhatsApp summary ----
# Any long random text. Vercel uses it to run the 8:30 AM summary.
CRON_SECRET=
WHATSAPP_TEMPLATE_DAILY=daily_summary

# ---- Voice filling on "Add lead" (server only) ----
# Free key: https://aistudio.google.com/apikey  (no card needed)
GEMINI_API_KEY=
# Optional. Leave empty to use Google's current Flash model.
GEMINI_MODEL=

# Optional: Google photo-real 3D fly-around on the client project page (/p/...).
# Add ONLY after checking Google Earth shows 3D buildings in your city. Needs a Google Cloud billing account:
# restrict the key to your website and the "Map Tiles API" + "Maps JavaScript API", and set a budget alert.
# Leave empty to use the free 3D satellite map (no key, no billing).
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
